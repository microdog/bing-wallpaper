<!-- Sample template only. deploy-gnome-settings.sh writes the installed copy
     using the requested picture directory value. -->
<background>
  <starttime>
    <year>2013</year>
    <month>01</month>
    <day>01</day>
    <hour>00</hour>
    <minute>00</minute>
    <second>00</second>
  </starttime>
  <!-- Today's image for 10 mins. -->
  <static>
    <duration>600.0</duration>
    <file>__BING_WALLPAPER_PICTURE_DIR__/today.jpg</file>
  </static>
  <transition>
    <duration>5.0</duration>
    <from>__BING_WALLPAPER_PICTURE_DIR__/today.jpg</from>
    <to>__BING_WALLPAPER_PICTURE_DIR__/random.jpg</to>
  </transition>

  <!-- Today's random image for 10 mins. -->
  <static>
    <duration>600.0</duration>
    <file>__BING_WALLPAPER_PICTURE_DIR__/random.jpg</file>
  </static>
  <transition>
    <duration>5.0</duration>
    <from>__BING_WALLPAPER_PICTURE_DIR__/random.jpg</from>
    <to>__BING_WALLPAPER_PICTURE_DIR__/today.jpg</to>
  </transition>
</background>
